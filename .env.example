SECOND_BRAIN_DATA_ROOT=/Users/your-name/SecondBrainData
SECOND_BRAIN_OWNER_NAME=Your Name
PERSONAL_AI_CONFIG=/Users/your-name/SecondBrainData/config.json
VASHISHT_GRAPH_STATE=/Users/your-name/SecondBrainData/runtime/knowledge_graph/graph_state.sqlite
MLX_LM_SERVER=/path/to/mlx_lm.server
MLX_WHISPER_PYTHON=/path/to/python
MLX_MODEL=mlx-community/gemma-4-e4b-it-4bit
# Optional local LoRA adapter. Never commit the adapter itself.
MLX_ADAPTER_PATH=/Users/your-name/SecondBrainData/models/adapter
# Optional private vault command. Keep its code, keys and data outside this repository.
PII_VAULT_TOOL=/Users/your-name/SecondBrainData/private/tools/pii_vault.py
# Optional override used by the encrypted migration kit.
PII_VAULT_KEYCHAIN_SERVICE=com.vashisht.personal-ai.pii-vault
